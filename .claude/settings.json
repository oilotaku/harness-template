{
  "$comment": "範例設定：實際欄位請依你使用的 Claude Code 版本文件調整。deny 清單是意圖宣示與第一層過濾，不是完整防護（rm -fr、小寫 drop table 等變形不會命中），真正的破壞性操作防護仍要靠 permission mode 與人工核准。第三輪 P0-8：把 harness 套進**你自己的專案**時，建議再加上 Write/Edit 形式的 deny（見 docs/getting-started.md），擋掉 implementer 改寫強制力本體。這個 repo 自己刻意不加——它就是模板本身，scripts/ 是它的產品程式碼；改由 guard 在「封存過 task 之後」動態保護，見 scripts/guard-hidden-tests.py 的 _harness_source_protected()。",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/init.py)",
      "Bash(python3 scripts/init.py:*)",
      "Bash(python3 scripts/machine-profile.py)",
      "Bash(python3 scripts/machine-profile.py:*)",
      "Bash(python3 scripts/service-scan.py)",
      "Bash(python3 scripts/service-scan.py:*)",
      "Bash(python3 scripts/env-guard.py)",
      "Bash(python3 scripts/env-guard.py:*)",
      "Bash(python3 scripts/lock-tests.py)",
      "Bash(python3 scripts/verify-locks.py)",
      "Bash(python3 scripts/guard-selfcheck.py)",
      "Bash(python3 scripts/seal-hidden-tests.py:*)",
      "Bash(python3 scripts/run-hidden-tests.py:*)",
      "Bash(python3 scripts/estimate-time.py:*)",
      "Bash(python3 scripts/check-design-tokens.py)",
      "Bash(python3 scripts/check-design-tokens.py:*)",
      "Bash(python3 scripts/discard-sealed-task.py:*)",
      "Bash(python3 scripts/export-sealed-task.py:*)",
      "Bash(python3 scripts/ci-verify.py:*)",
      "Bash(python3 scripts/read-ci-report.py:*)",
      "Bash(python3 scripts/test-ci-verify.py)",
      "Bash(python3 scripts/test-protection-levels.py)",
      "Bash(python3 scripts/version.py:*)",
      "Bash(python3 scripts/suggest-skills.py)",
      "Bash(python3 scripts/test-guards.py)",
      "Bash(python3 scripts/test-locks.py)",
      "Bash(python3 scripts/test-vault.py)",
      "Bash(python3 scripts/test-env-guard.py)",
      "Bash(python3 scripts/test-config.py)",
      "Bash(python3 scripts/test-scan-json.py)",
      "Bash(python3 scripts/test-timing.py)",
      "Bash(python3 scripts/suggest-skills.py:*)",
      "Bash(python3 scripts/test-skills.py)",
      "Bash(python3 scripts/show-attempts.py:*)",
      "Bash(python3 scripts/test-attempts.py)",
      "Bash(python3 scripts/test-version.py)",
      "Bash(python3 scripts/test-design.py)",
      "Bash(python3 scripts/guard-selfcheck.py:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(*DROP TABLE*)",
      "Bash(*TRUNCATE*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard-selfcheck.py\"",
            "timeout": 30,
            "statusMessage": "檢查防作弊機制是否生效"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard-hidden-tests.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
